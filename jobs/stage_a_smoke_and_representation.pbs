#!/bin/bash
#PBS -N stage_a_repr
#PBS -q pleiades1
#PBS -l select=1:ncpus=8:ngpus=2:host=pleiades1
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o /home/itaein/Personal_Research/logs/stage_a/scheduler.log

set -euo pipefail

PROJECT_ROOT=/home/itaein/Personal_Research
STAGE_PYTHON=/home/itaein/.conda/envs/egodex-box/bin/python
CURRENT_STAGE=BOOT

cd "$PROJECT_ROOT"
mkdir -p logs/stage_a/{B0,B1,B2,B3} checkpoints/stage_a/{smoke/B0,smoke/B1,smoke/B2,smoke/B3,B0,B1,B2,B3}
export PYTHONPATH="$PROJECT_ROOT/src"
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4
# After FINAL_GATE, Stage B uses train/val to select probes and then runs the
# exactly-once test95 final evaluation in this same two-GPU allocation.
export STAGE_B_AUTO_RUN=1
exec > >(tee -a logs/stage_a/integrated.log) 2>&1

record_failure() {
  exit_code=$?
  if [ "$exit_code" -ne 0 ]; then
    "$STAGE_PYTHON" tools/stage_a_control.py record-failure \
      --stage "$CURRENT_STAGE" --exit-code "$exit_code" || true
  fi
  exit "$exit_code"
}
trap record_failure EXIT

echo "STAGE_A_JOB_START $(date --iso-8601=seconds)"
echo "PBS_JOBID=${PBS_JOBID:-unknown} HOSTNAME=${HOSTNAME:-unknown}"

CURRENT_STAGE=PRECHECK_RUNTIME
"$STAGE_PYTHON" tools/stage_a_control.py init

CURRENT_STAGE=GPU_VERIFY
nvidia-smi
GPU_COUNT=$("$STAGE_PYTHON" -c 'import torch; print(torch.cuda.device_count())')
GPU_NAME=$("$STAGE_PYTHON" -c 'import torch; print("|".join(torch.cuda.get_device_name(i) for i in range(torch.cuda.device_count())))')
GPU_MEMORY_MIB=$("$STAGE_PYTHON" -c 'import torch; print(min(torch.cuda.get_device_properties(i).total_memory for i in range(torch.cuda.device_count())) // 2**20 if torch.cuda.device_count() else 0)')
"$STAGE_PYTHON" tools/stage_a_control.py record-gpu \
  --name "$GPU_NAME" --memory-mib "$GPU_MEMORY_MIB" --count "$GPU_COUNT"

run_smoke_variant() {
  trap - EXIT
  variant=$1
  device=$2
  echo "SMOKE_${variant}_START device=${device} $(date --iso-8601=seconds)"
  "$STAGE_PYTHON" tools/train_stage_a.py \
    --mode smoke \
    --variant "$variant" \
    --device "$device" \
    --output "analysis/stage_a_smoke_${variant}.json" \
    > >(tee "logs/stage_a/${variant}/smoke.log") 2>&1
  echo "SMOKE_${variant}_END device=${device} $(date --iso-8601=seconds)"
}

run_smoke_pair() {
  left=$1
  right=$2
  run_smoke_variant "$left" cuda:0 &
  left_pid=$!
  run_smoke_variant "$right" cuda:1 &
  right_pid=$!
  left_status=0
  right_status=0
  wait "$left_pid" || left_status=$?
  wait "$right_pid" || right_status=$?
  if [ "$left_status" -ne 0 ]; then
    return "$left_status"
  fi
  return "$right_status"
}

CURRENT_STAGE=SMOKE_B0_B1
nvidia-smi
run_smoke_pair B0 B1
CURRENT_STAGE=SMOKE_B2_B3
nvidia-smi
run_smoke_pair B2 B3
nvidia-smi

CURRENT_STAGE=SMOKE_GATE
"$STAGE_PYTHON" tools/stage_a_control.py smoke-gate

CURRENT_STAGE=CACHE_FEATURES
"$STAGE_PYTHON" tools/cache_stage_a_features.py \
  --model-cache /ssd1/itaein/datasets/RoboCerebra/model_cache/r4_clip \
  --batch-size 64 \
  --device cuda:0 \
  --audit analysis/stage_a_clip_cache_audit.json \
  > >(tee logs/stage_a/cache.log) 2>&1

CURRENT_STAGE=CACHE_GATE
"$STAGE_PYTHON" tools/stage_a_control.py cache-gate

CURRENT_STAGE=BUDGET_GATE
"$STAGE_PYTHON" tools/stage_a_control.py decide-budget
STAGE_EPOCHS=$("$STAGE_PYTHON" tools/stage_a_control.py print-epochs)
echo "STAGE_A_SELECTED_EPOCHS_PER_MODEL=$STAGE_EPOCHS"

run_training_variant() {
  trap - EXIT
  variant=$1
  device=$2
  echo "TRAIN_${variant}_START device=${device} $(date --iso-8601=seconds)"
  "$STAGE_PYTHON" tools/train_stage_a.py \
    --mode full \
    --variant "$variant" \
    --epochs "$STAGE_EPOCHS" \
    --device "$device" \
    --output "analysis/stage_a_training_${variant}.json" \
    > >(tee "logs/stage_a/${variant}/train.log") 2>&1
  echo "TRAIN_${variant}_END device=${device} $(date --iso-8601=seconds)"
}

run_training_pair() {
  left=$1
  right=$2
  run_training_variant "$left" cuda:0 &
  left_pid=$!
  run_training_variant "$right" cuda:1 &
  right_pid=$!
  left_status=0
  right_status=0
  wait "$left_pid" || left_status=$?
  wait "$right_pid" || right_status=$?
  if [ "$left_status" -ne 0 ]; then
    return "$left_status"
  fi
  return "$right_status"
}

CURRENT_STAGE=TRAIN_B0_B1
nvidia-smi
run_training_pair B0 B1
CURRENT_STAGE=TRAIN_B2_B3
nvidia-smi
run_training_pair B2 B3
nvidia-smi

CURRENT_STAGE=FINAL_GATE
"$STAGE_PYTHON" tools/stage_a_control.py training-gate

trap - EXIT
echo "STAGE_A_JOB_END $(date --iso-8601=seconds)"
exit 0
